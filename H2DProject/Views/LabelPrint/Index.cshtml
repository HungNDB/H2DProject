@using H2DProject.Data
@model Order
@{
    ViewData["Title"] = "In tem — Đơn #" + Model.OrderId;
}

<div class="lp-shell">

    <div class="lp-topbar">
        <a href="javascript:history.back()" class="lp-back">←</a>
        <div class="lp-topbar-center">
            <div class="lp-topbar-title">In tem · Đơn #@Model.OrderId</div>
            <div class="lp-topbar-sub">Khổ 50×30mm · Xprinter XP-365B</div>
        </div>
        <button class="lp-topbar-btn" onclick="printSelected()">🖨 In</button>
    </div>

    <div class="lp-hint">Tick mon · Nhập ghi chú tên khách · Bấm In</div>

    <div class="lp-list" id="item-list">
        @{
            int gi = 0;
        }
        @foreach (var item in Model.OrderItems)
        {
            var tops = item.OrderItemToppings.Any()
            ? string.Join(", ", item.OrderItemToppings.Select(t => $"+{t.Quantity} {t.Topping?.Name}"))
            : "";
            var price = item.UnitPrice * item.Quantity
            + item.OrderItemToppings.Sum(t => t.UnitPrice * t.Quantity);

            for (int copy = 1; copy <= item.Quantity; copy++)
            {
                var copyLbl = item.Quantity > 1 ? $" (ly {copy}/{item.Quantity})" : "";
                <div class="lp-card" id="lc-@gi">

                    <label class="lp-card-top">
                        <input type="checkbox" class="lp-cb" data-idx="@gi" checked
                               onchange="onToggle(@gi, this)">
                        <div class="lp-card-info">
                            <div class="lp-card-name">@item.Product?.Name@copyLbl</div>
                            @if (!string.IsNullOrEmpty(tops))
                            {
                                <div class="lp-card-top-txt">@tops</div>
                            }
                        </div>
                    </label>

                    <div class="lp-note-row" id="nr-@gi">
                        <div class="lp-note-label">Ghi chú khách (in to, nổi bật)</div>
                        <input type="text" class="lp-note-inp" id="note-@gi"
                               placeholder="VD: Hùng..."
                               maxlength="25">
                        <div class="lp-qtags">
                            <span class="lp-qt" onclick="setNote(@gi,'ít đường')">Ít đường</span>
                            <span class="lp-qt" onclick="setNote(@gi,'không đường')">K.đường</span>
                            <span class="lp-qt" onclick="setNote(@gi,'ít đá')">Ít đá</span>
                            <span class="lp-qt" onclick="setNote(@gi,'không đá')">K.đá</span>
                        </div>
                    </div>

                    <input type="hidden" class="lp-hidden"
                           data-idx="@gi"
                           data-id="@item.OrderItemId"
                           data-name="@(item.Product?.Name ?? "")"
                           data-tops="@tops"
                           data-price="@price"
                           data-ci="@copy"
                           data-ct="@item.Quantity">
                </div>
                gi++;
            }
        }
    </div>

    <div class="lp-bottom">
        <label class="lp-chk-all">
            <input type="checkbox" id="chk-all" checked onchange="toggleAll(this)">
            <span>Chọn tất cả &nbsp;·&nbsp; <b id="sel-count">@Model.OrderItems.Sum(i => i.Quantity)</b> tem</span>
        </label>
        <button class="lp-btn-print" id="btn-print" onclick="printSelected()">
            🖨 In <span id="btn-count">@Model.OrderItems.Sum(i => i.Quantity)</span>
        </button>
    </div>
</div>

@* Preview modal *@
<div id="modal" class="lp-modal">
    <div class="lp-modal-box">
        <div class="lp-modal-hd">
            <span>Xem trước <span id="prev-count"></span> tem</span>
            <button onclick="closeModal()" class="lp-modal-close">✕</button>
        </div>
        <div class="lp-modal-body" id="prev-body"></div>
        <div class="lp-modal-ft">
            <button class="btn btn-secondary" onclick="closeModal()">← Sửa lại</button>
            <button class="btn btn-primary" id="btn-confirm" onclick="confirmPrint()">
                🖨 Xác nhận in
            </button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Styles {
    <style>
        /* ── Shell ── */
        .lp-shell {
            display: flex;
            flex-direction: column;
            min-height: calc(100dvh - env(safe-area-inset-bottom,0px));
            background: #f3f4f6;
            padding-bottom: calc(76px + env(safe-area-inset-bottom,0px));
        }

        /* ── Top bar ── */
        .lp-topbar {
            background: #3d2b0f;
            color: #fff;
            display: flex;
            align-items: center;
            padding: 10px 14px;
            gap: 10px;
        }

        .lp-back {
            color: #fff;
            font-size: 20px;
            text-decoration: none;
            padding: 2px 8px 2px 0;
        }

        .lp-topbar-center {
            flex: 1;
        }

        .lp-topbar-title {
            font-size: 14px;
            font-weight: 600;
        }

        .lp-topbar-sub {
            font-size: 10px;
            opacity: .65;
            margin-top: 1px;
        }

        .lp-topbar-btn {
            background: #fff;
            color: #3d2b0f;
            border: none;
            border-radius: 8px;
            padding: 7px 14px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
        }

        /* ── Hint ── */
        .lp-hint {
            font-size: 11px;
            color: #6b7280;
            text-align: center;
            padding: 7px 16px;
            background: #fff;
            border-bottom: 1px solid #e5e7eb;
        }

        /* ── List ── */
        .lp-list {
            padding: 10px 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        /* ── Card ── */
        .lp-card {
            background: #fff;
            border-radius: 12px;
            border: 2px solid #e5e7eb;
            overflow: hidden;
            transition: border-color .12s, opacity .12s;
        }

            .lp-card.off {
                opacity: .4;
                border-color: #f3f4f6;
            }

        .lp-card-top {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 11px 14px 8px;
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }

        .lp-cb {
            width: 20px;
            height: 20px;
            accent-color: #c9952c;
            flex-shrink: 0;
            margin-top: 2px;
            cursor: pointer;
        }

        .lp-card-info {
            flex: 1;
            min-width: 0;
        }

        .lp-card-name {
            font-size: 15px;
            font-weight: 700;
            color: #111827;
            line-height: 1.3;
        }

        .lp-card-top-txt {
            font-size: 11px;
            color: #059669;
            margin-top: 3px;
        }

        /* ── Note row ── */
        .lp-note-row {
            padding: 0 14px 12px;
        }

        .lp-note-label {
            font-size: 10px;
            font-weight: 600;
            color: #c9952c;
            text-transform: uppercase;
            letter-spacing: .4px;
            margin-bottom: 5px;
        }

        .lp-note-inp {
            width: 100%;
            padding: 9px 12px;
            border: 2px solid #ddd6fe;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            color: #dc2626;
            background: #fbf1dc;
            box-sizing: border-box;
        }

            .lp-note-inp:focus {
                outline: none;
                border-color: #c9952c;
                box-shadow: 0 0 0 3px rgba(201,149,44,.12);
            }

            .lp-note-inp::placeholder {
                color: #c4b5fd;
                font-weight: 400;
                font-size: 13px;
            }

        /* ── Quick tags ── */
        .lp-qtags {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            margin-top: 6px;
        }

        .lp-qt {
            padding: 3px 9px;
            border: 1px solid #e5e7eb;
            border-radius: 999px;
            font-size: 11px;
            color: #374151;
            cursor: pointer;
            background: #f9fafb;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }

            .lp-qt:active {
                background: #ede9fe;
                border-color: #c9952c;
                color: #c9952c;
            }

        /* ── Bottom bar ── */
        .lp-bottom {
            position: fixed;
            bottom: env(safe-area-inset-bottom,0px);
            left: 0;
            right: 0;
            z-index: 100;
            background: #fff;
            border-top: 1px solid #e5e7eb;
            padding: 10px 14px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .lp-chk-all {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: #374151;
            cursor: pointer;
            flex: 1;
        }

            .lp-chk-all input {
                width: 18px;
                height: 18px;
                accent-color: #c9952c;
            }

        .lp-btn-print {
            background: #c9952c;
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 10px 20px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            min-height: 44px;
            white-space: nowrap;
            -webkit-tap-highlight-color: transparent;
        }

            .lp-btn-print:disabled {
                opacity: .5;
            }

            .lp-btn-print:active {
                transform: scale(.96);
            }

        /* ── Preview modal ── */
        .lp-modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.6);
            z-index: 9999;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }

        .lp-modal-box {
            background: #fff;
            border-radius: 16px;
            width: 100%;
            max-width: 340px;
            max-height: 82vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .lp-modal-hd {
            padding: 14px 16px 10px;
            border-bottom: 1px solid #f3f4f6;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 600;
            font-size: 14px;
        }

        .lp-modal-close {
            background: none;
            border: none;
            font-size: 22px;
            color: #9ca3af;
            cursor: pointer;
        }

        .lp-modal-body {
            flex: 1;
            overflow-y: auto;
            padding: 10px 16px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .lp-modal-ft {
            padding: 10px 16px 14px;
            border-top: 1px solid #f3f4f6;
            display: flex;
            gap: 8px;
        }

            .lp-modal-ft .btn {
                flex: 1;
                min-height: 44px;
            }

        /* ── Tem preview card ── */
        .lp-tem-prev {
            border: 1.5px dashed #c9952c;
            border-radius: 8px;
            overflow: hidden;
            font-family: 'Courier New', monospace;
        }

        .lp-tem-body {
            padding: 8px 10px;
            background: #fbf1dc;
        }

        .lp-tem-name {
            font-size: 14px;
            font-weight: 800;
            color: #111827;
            line-height: 1.3;
        }

        .lp-tem-tops {
            font-size: 11px;
            color: #059669;
            margin-top: 3px;
        }

        .lp-tem-note {
            margin-top: 6px;
            padding: 5px 8px;
            background: #111827;
            color: #fff;
            font-size: 13px;
            font-weight: 700;
            border-radius: 5px;
            text-align: center;
            letter-spacing: .3px;
        }

        .lp-tem-size {
            font-size: 9px;
            color: #9ca3af;
            text-align: right;
            margin-top: 4px;
        }
    </style>
}

@section Scripts {
    <script>
        const orderId = @Model.OrderId;
        const af = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        let selected = new Set();

        // Init: chọn hết
        document.querySelectorAll('.lp-cb').forEach(cb => selected.add(+cb.dataset.idx));
        updateCount();

        // ── Toggle ────────────────────────────────────────────────
        function onToggle(idx, cb) {
            cb.checked ? selected.add(idx) : selected.delete(idx);
            document.getElementById('lc-' + idx).classList.toggle('off', !cb.checked);
            updateCount();
        }
        function toggleAll(master) {
            document.querySelectorAll('.lp-cb').forEach(cb => {
                cb.checked = master.checked;
                const idx = +cb.dataset.idx;
                master.checked ? selected.add(idx) : selected.delete(idx);
                document.getElementById('lc-' + idx).classList.toggle('off', !master.checked);
            });
            updateCount();
        }
        function updateCount() {
            const n = selected.size;
            document.getElementById('sel-count').textContent = n;
            document.getElementById('btn-count').textContent = n;
            document.getElementById('btn-print').disabled = n === 0;
        }

        // ── Quick note ─────────────────────────────────────────────
        function setNote(idx, text) {
            const inp = document.getElementById('note-' + idx);
            inp.value = text;
            inp.focus();
        }

        // ── Build payload ──────────────────────────────────────────
        function buildItems() {
            const items = [];
            selected.forEach(idx => {
                const h    = document.querySelector(`.lp-hidden[data-idx="${idx}"]`);
                const note = (document.getElementById('note-' + idx)?.value ?? '').trim();
                if (!h) return;
                items.push({
                    orderItemId: +h.dataset.id,
                    productName: h.dataset.name,
                    toppings:    h.dataset.tops || null,
                    totalPrice:  +h.dataset.price,
                    note:        note || null,
                    copyIndex:   +h.dataset.ci,
                    copyLabel:   +h.dataset.ct
                });
            });
            return items;
        }

        // ── Preview ────────────────────────────────────────────────
        function printSelected() {
            if (!selected.size) { alert('Chưa chọn tem nào!'); return; }
            const items = buildItems();

            document.getElementById('prev-count').textContent = items.length;
            document.getElementById('prev-body').innerHTML = items.map(it => {
                const copyTxt = it.copyLabel > 1 ? ` (ly ${it.copyIndex}/${it.copyLabel})` : '';
                return `
                <div class="lp-tem-prev">
                    <div class="lp-tem-body">
                        <div class="lp-tem-name">${it.productName}${copyTxt}</div>
                        ${it.toppings ? `<div class="lp-tem-tops">${it.toppings}</div>` : ''}
                        ${it.note     ? `<div class="lp-tem-note">${it.note}</div>` : ''}
                        <div class="lp-tem-size">50×30mm · Xprinter XP-365B</div>
                    </div>
                </div>`;
            }).join('');

            document.getElementById('modal').style.display = 'flex';
        }
        function closeModal() { document.getElementById('modal').style.display = 'none'; }
        document.getElementById('modal').addEventListener('click', e => { if (e.target.id === 'modal') closeModal(); });

        // ── Confirm print ──────────────────────────────────────────
        async function confirmPrint() {
            const items = buildItems();
            const btn   = document.getElementById('btn-confirm');
            btn.disabled = true; btn.textContent = '⏳ Đang in...';

            try {
                const res  = await fetch('/LabelPrint/Print', {
                    method: 'POST',
                    headers: {
                        'Content-Type':              'application/json',
                        'RequestVerificationToken':   af
                    },
                    body: JSON.stringify({ orderId, items })
                });
                const data = await res.json();

                if (!res.ok) { alert('Lỗi: ' + (data.error || res.status)); return; }

                closeModal();
                showToast(`✓ Đã in ${data.count} tem thành công!`, 'success');

                // Flash xanh các card vừa in
                selected.forEach(idx => {
                    const c = document.getElementById('lc-' + idx);
                    if (!c) return;
                    c.style.borderColor = '#6ee7b7';
                    c.style.background  = '#fbf1dc';
                    setTimeout(() => { c.style.borderColor=''; c.style.background=''; }, 2000);
                });

            } catch {
                alert('Không kết nối được máy in!\n\nKiểm tra:\n• Xprinter đang bật\n• Tên máy in Windows: "Xprinter XP-365B"\n• Driver đã cài đúng');
            } finally {
                btn.disabled = false; btn.textContent = '🖨 Xác nhận in';
            }
        }
    </script>
}
