@using H2DProject.Models
@model Product
@{ ViewData["Title"] = "Thêm sản phẩm"; }

<div class="form-container">
    <div class="form-page-header">
        <a asp-action="Index" class="form-back-link">← Quay lại</a>
        <h2 class="form-page-title">Thêm sản phẩm mới</h2>
    </div>

    <div class="form-card">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label">
                    Tên sản phẩm <span class="required">*</span>
                </label>
                <input asp-for="Name" placeholder="VD: Trà đào cam sả" class="form-input" />
                <span asp-validation-for="Name" style="color:red;font-size:0.8rem;"></span>
            </div>

            <div class="form-group">
                <label class="form-label">
                    Danh mục <span class="required">*</span>
                </label>
                <select asp-for="CategoryId" asp-items="ViewBag.CategoryList" class="form-select">
                    <option value="">-- Chọn danh mục --</option>
                </select>
                <span asp-validation-for="CategoryId" style="color:red;font-size:0.8rem;"></span>
            </div>

            <div class="form-group">
                <label class="form-label">
                    Giá bán (₫) <span class="required">*</span>
                </label>
                <input asp-for="Price" type="number" min="0" step="500" placeholder="VD: 35000" class="form-input" />
                <span asp-validation-for="Price" style="color:red;font-size:0.8rem;"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Mô tả</label>
                <textarea asp-for="Description" rows="3" placeholder="Mô tả ngắn về sản phẩm..." class="form-textarea"></textarea>
            </div>

            <div class="form-group">
                <label class="form-label">Ảnh sản phẩm</label>
                <input type="file" name="imageFile" accept="image/*" class="form-image-upload" onchange="previewImg(this)" />
                <img id="imgPreview" src="" alt="preview" class="form-image-preview" />
            </div>

            <div style="margin-bottom:24px;display:flex;align-items:center;gap:10px;">
                <input type="checkbox" name="IsAvailable" id="isAvail" checked
                       value="true"
                       style="width:18px;height:18px;accent-color:var(--teal-600);cursor:pointer;" />
                <input type="hidden" name="IsAvailable" value="false" />
                <label for="isAvail" style="font-size:0.9rem;font-weight:500;cursor:pointer;">
                    Đang bán (hiển thị cho nhân viên gọi món)
                </label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-full">➕ Thêm sản phẩm</button>
                <a asp-action="Index" class="btn btn-secondary">Huỷ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function previewImg(input) {
    const preview = document.getElementById('imgPreview');
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => { preview.src = e.target.result; preview.style.display = 'block'; };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>
}
