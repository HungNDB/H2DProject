@* ── History.cshtml ── *@
@using H2DProject.Models
@model List<Order>
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>

<div class="card history-filter-card">
    <form method="get" class="history-filter-form">
        <div class="hf-row">
            <div class="hf-field">
                <label class="hf-label">Từ ngày</label>
                <input type="date" name="from" class="form-input" value="@ViewBag.From">
            </div>
            <div class="hf-field">
                <label class="hf-label">Đến ngày</label>
                <input type="date" name="to" class="form-input" value="@ViewBag.To">
            </div>
        </div>
        <div class="hf-row">
            <div class="hf-field hf-field--grow">
                <label class="hf-label">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="Pending" selected="@(ViewBag.Status == "Pending")">Chờ</option>
                    <option value="InProgress" selected="@(ViewBag.Status == "InProgress")">Đang pha</option>
                    <option value="Completed" selected="@(ViewBag.Status == "Completed")">Hoàn thành</option>
                    <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Đã huỷ</option>
                </select>
            </div>
            <div class="hf-actions">
                <button type="submit" class="btn btn-primary">Lọc</button>
                <a href="@Url.Action("History")" class="btn btn-secondary">Reset</a>
            </div>
        </div>
        <div class="hf-revenue">
            <span class="hf-revenue-label">Doanh thu</span>
            <span class="hf-revenue-value">@((ViewBag.Revenue as decimal? ?? 0).ToString("N0")) ₫</span>
        </div>
    </form>
</div>

<div class="card history-list-card">
    @if (!Model.Any())
    {
        <div class="history-empty">Không có đơn hàng nào</div>
    }
    else
    {
        <div class="history-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Bàn</th>
                        <th class="hide-on-mobile">Nhân viên</th>
                        <th>Thời gian</th>
                        <th>Tổng tiền</th>
                        <th class="hide-on-mobile">Thanh toán</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td class="mono">#@o.OrderId</td>
                            <td>@(o.Table?.TableNumber ?? "—")</td>
                            <td class="hide-on-mobile">@(o.Staff?.FullName ?? "—")</td>
                            <td class="mono">@o.CreatedAt?.ToString("HH:mm dd/MM")</td>
                            <td class="mono" style="color:var(--teal-600);font-weight:600;">
                                @o.TotalAmount?.ToString("N0") ₫
                            </td>
                            <td class="hide-on-mobile" style="font-size:12px;color:var(--gray-500);">@(o.PaymentMethod ?? "—")</td>
                            <td>
                                <span class="badge badge-@o.Status?.ToLower()">
                                    @(o.Status == "Pending" ? "Chờ" : o.Status == "InProgress" ? "Đang pha" : o.Status == "Completed" ? "Hoàn thành" : "Đã huỷ")
                                </span>
                            </td>
                            <td>
                                <a asp-action="Receipt" asp-route-id="@o.OrderId"
                                   class="btn btn-secondary btn-sm">Xem</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="history-mobile-list">
            @foreach (var o in Model)
            {
                <a asp-action="Receipt" asp-route-id="@o.OrderId" class="ho-row">
                    <div class="ho-left">
                        <div class="ho-top">
                            <span class="ho-id mono">#@o.OrderId</span>
                            <span class="ho-table">🪑 @(o.Table?.TableNumber ?? "—")</span>
                            <span class="badge badge-@o.Status?.ToLower() ho-badge">
                                @(o.Status == "Pending" ? "Chờ" : o.Status == "InProgress" ? "Đang pha" : o.Status == "Completed" ? "Hoàn thành" : "Đã huỷ")
                            </span>
                        </div>
                        <div class="ho-bottom">
                            <span class="ho-staff">@(o.Staff?.FullName ?? "—")</span>
                            <span class="ho-time mono">@o.CreatedAt?.ToString("HH:mm dd/MM")</span>
                            <span class="ho-pay">@(o.PaymentMethod ?? "—")</span>
                        </div>
                    </div>
                    <div class="ho-amount mono">
                        @o.TotalAmount?.ToString("N0")<br><span class="ho-unit">₫</span>
                    </div>
                </a>
            }
        </div>
    }
</div>

@section Scripts {
    <script>initSignalR('pos',{});</script>
}
