@* ── History.cshtml ── *@
@using H2DProject.Models
@model List<Order>
@{ ViewData["Title"] = "Lịch sử đơn hàng"; }
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>
<div class="card" style="margin-bottom:14px;">
    <form method="get" style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
        <div>
            <div style="font-size:11px;color:var(--gray-500);margin-bottom:4px;">Từ ngày</div>
            <input type="date" name="from" class="form-input" style="width:160px;" value="@ViewBag.From">
        </div>
        <div>
            <div style="font-size:11px;color:var(--gray-500);margin-bottom:4px;">Đến ngày</div>
            <input type="date" name="to"   class="form-input" style="width:160px;" value="@ViewBag.To">
        </div>
        <div>
            <div style="font-size:11px;color:var(--gray-500);margin-bottom:4px;">Trạng thái</div>
            <select name="status" class="form-select" style="width:150px;">
                <option value="">Tất cả</option>
                <option value="Pending"    selected="@(ViewBag.Status=="Pending")">Chờ</option>
                <option value="InProgress" selected="@(ViewBag.Status=="InProgress")">Đang pha</option>
                <option value="Completed"  selected="@(ViewBag.Status=="Completed")">Hoàn thành</option>
                <option value="Cancelled"  selected="@(ViewBag.Status=="Cancelled")">Đã huỷ</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Lọc</button>
        <a href="@Url.Action("History")" class="btn btn-secondary">Đặt lại</a>
        <div style="margin-left:auto;text-align:right;">
            <div style="font-size:11px;color:var(--gray-500);">Doanh thu</div>
            <div style="font-size:18px;font-weight:600;color:var(--teal-600);font-family:var(--font-mono);">
                @((ViewBag.Revenue as decimal? ?? 0).ToString("N0")) ₫
            </div>
        </div>
    </form>
</div>

<div class="card" style="overflow-x:auto;">
    @if (!Model.Any())
    {
        <div style="text-align:center;padding:3rem;color:var(--gray-300);">Không có đơn hàng nào</div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th><th>Bàn</th><th>Nhân viên</th>
                    <th>Thời gian</th><th>Tổng tiền</th>
                    <th>Thanh toán</th><th>Trạng thái</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td class="mono">#@o.OrderId</td>
                        <td>@o.Table.TableNumber</td>
                        <td>@o.Staff.FullName</td>
                        <td class="mono">@o.CreatedAt?.ToString("HH:mm dd/MM")</td>
                        <td class="mono" style="color:var(--teal-600);font-weight:600;">
                            @o.TotalAmount?.ToString("N0") ₫
                        </td>
                        <td style="font-size:12px;color:var(--gray-500);">@(o.PaymentMethod ?? "—")</td>
                        <td>
                            <span class="badge badge-@o.Status.ToLower()">
                                @(o.Status=="Pending"?"Chờ":o.Status=="InProgress"?"Đang pha":o.Status=="Completed"?"Hoàn thành":"Đã huỷ")
                            </span>
                        </td>
                        <td>
                            <a asp-action="Receipt" asp-route-id="@o.OrderId"
                               class="btn btn-secondary btn-sm">Xem</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts { <script>initSignalR('pos',{});</script> }
