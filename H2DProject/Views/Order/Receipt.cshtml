@section Scripts {
    <script>
        const orderId    = @Model.OrderId;
        const af         = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                const banks = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    banks,
                    new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }
            ));
        let currentTotal = @(Model.TotalAmount ?? 0);
        let bankIdx      = 0;
        let _pid = 0, _pname = '', _pprice = 0;

        function fmtVND(n) {
            return new Intl.NumberFormat('vi-VN').format(Math.round(n)) + ' ₫';
        }

        // ── Helpers lấy element an toàn ──────────────────────────
        const $id  = id  => document.getElementById(id);

        // ── QR ────────────────────────────────────────────────────
        function renderQR() {
            const bank = banks.length > 0 ? banks[bankIdx] : null;
            const desc = encodeURIComponent('Don #' + orderId);
            const amt  = Math.round(currentTotal);
            let url;
            if (bank) {
                const name = encodeURIComponent(bank.accountName);
                url = `https://img.vietqr.io/image/${bank.bankId}-${bank.accountNumber}-qr_only.png`
                    + `?amount=${amt}&addInfo=${desc}&accountName=${name}`;
            } else {
                url = `https://img.vietqr.io/image/VCB-0081001280745-qr_only.png`
                    + `?amount=${amt}&addInfo=${desc}&accountName=${encodeURIComponent('HYANG CAFE')}`;
            }
            $id('vietqr-img').src = url;
            const amtEl = $id('qr-amount-text');
            if (amtEl) amtEl.textContent = fmtVND(currentTotal);
        }

        function selectBank(btn) {
            document.querySelectorAll('.rc-bank-tab').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            bankIdx = parseInt(btn.dataset.idx);
            renderQR();
        }

        function updateTotal(newTotal) {
            currentTotal = newTotal;
            $id('disp-total').textContent = fmtVND(newTotal);
            renderQR();
        }

        // ── Popup thêm món ────────────────────────────────────────
        function openAddPopup() {
            const popup = $id('add-popup');
            if (!popup) return;                 // guard: canEdit=false thì không có popup
            popup.style.display = 'flex';
            backToList();
            setTimeout(() => $id('ap-search')?.focus(), 150);
        }

        function closeAddPopup() {
            const popup = $id('add-popup');
            if (popup) popup.style.display = 'none';
        }

        function apSearch() {
            const raw = $id('ap-search')?.value ?? '';
            const q   = raw.normalize('NFD').replace(/[\u0300-\u036f]/g,'')
                           .replace(/\u0111/g,'d').replace(/\u0110/g,'D').toLowerCase();
            document.querySelectorAll('.ap-row').forEach(row => {
                const name = (row.dataset.name ?? '').normalize('NFD')
                                .replace(/[\u0300-\u036f]/g,'')
                                .replace(/\u0111/g,'d').replace(/\u0110/g,'D').toLowerCase();
                row.style.display = name.includes(q) ? '' : 'none';
            });
        }

        function selectProduct(pid, name, price) {
            _pid = pid; _pname = name; _pprice = price;

            const topSec = $id('ap-topping-section');   // luôn tồn tại
            const nameEl = $id('ap-selected-name');
            const priceEl = $id('ap-selected-price');

            if (nameEl)  nameEl.textContent  = name;
            if (priceEl) priceEl.textContent = fmtVND(price);

            // Uncheck tất cả topping cũ
            document.querySelectorAll('.ap-topping-cb').forEach(cb => cb.checked = false);
            recalcAddTotal();

            // Ẩn list, hiện topping section
            const listEl    = $id('ap-list');
            const searchBar = $id('ap-search-bar');
            if (listEl)    listEl.style.display    = 'none';
            if (searchBar) searchBar.style.display = 'none';
            if (topSec)    topSec.style.display    = '';
        }

        function backToList() {
            const topSec    = $id('ap-topping-section');
            const listEl    = $id('ap-list');
            const searchBar = $id('ap-search-bar');
            const searchIn  = $id('ap-search');

            if (topSec)    topSec.style.display    = 'none';
            if (listEl)    listEl.style.display    = '';
            if (searchBar) searchBar.style.display = '';
            if (searchIn)  searchIn.value = '';

            document.querySelectorAll('.ap-row').forEach(r => r.style.display = '');
            _pid = 0;
        }

        function recalcAddTotal() {
            let extra = 0;
            document.querySelectorAll('.ap-topping-cb:checked').forEach(cb => {
                extra += parseFloat(cb.dataset.price ?? 0);
            });
            const el = $id('ap-total-price');
            if (el) el.textContent = fmtVND(_pprice + extra);
        }

        async function confirmAddItem() {
            if (!_pid) return;

            const toppings = [];
            document.querySelectorAll('.ap-topping-cb:checked').forEach(cb => {
                toppings.push({ toppingId: parseInt(cb.value), quantity: 1 });
            });

            const fd = new FormData();
            fd.append('orderId',  orderId);
            fd.append('itemJson', JSON.stringify({ productId: _pid, note: null, toppings }));
            fd.append('__RequestVerificationToken', af);

            const btn = $id('ap-topping-section')?.querySelector('.btn-primary');
            if (btn) { btn.disabled = true; btn.textContent = 'Đang thêm...'; }

            try {
                const res  = await fetch('/Order/AddItem', { method: 'POST', body: fd });
                const data = await res.json();

                if (!res.ok) {
                    alert(data?.message ?? 'Lỗi thêm món');
                    if (btn) { btn.disabled = false; btn.textContent = 'Thêm vào đơn +'; }
                    return;
                }

                // Tên topping đã chọn
                const selectedToppings = Array.from(document.querySelectorAll('.ap-topping-cb:checked'))
                    .map(cb => ({ name: cb.dataset.name, price: parseFloat(cb.dataset.price ?? 0) }));

                // Thêm row vào receipt
                const wrap = document.createElement('div');
                wrap.className = 'ri-wrap';
                wrap.id        = 'ri-' + data.orderItemId;
                wrap.innerHTML = `
                    <div class="receipt-item">
                        <span><span class="ri-qty">×1</span> ${_pname}</span>
                        <div style="display:flex;align-items:center;gap:6px;">
                            <span class="ri-price">${fmtVND(data.unitPrice + (data.toppingTotal ?? 0))}</span>
                            <button class="ri-del" onclick="removeItem(${data.orderItemId},this)" title="Xoá">✕</button>
                        </div>
                    </div>
                    ${selectedToppings.map(t => `
                        <div class="receipt-item" style="padding-left:20px;font-size:.88em;color:#9ca3af;">
                            <span style="color:#c9952c;">+1 ${t.name}</span>
                            <span class="ri-price" style="color:#9ca3af;">${fmtVND(t.price)}</span>
                        </div>`).join('')}
                `;
                $id('receipt-items').appendChild(wrap);

                updateTotal(data.newTotal);
                closeAddPopup();
                showToast('✓ Đã thêm: ' + _pname, 'success');

            } catch(e) {
                alert('Lỗi kết nối!');
            } finally {
                if (btn) { btn.disabled = false; btn.textContent = 'Thêm vào đơn +'; }
            }
        }

        // ── Xoá món ───────────────────────────────────────────────
        async function removeItem(itemId, btn) {
            if (!confirm('Xoá món này khỏi đơn?')) return;
            btn.disabled = true; btn.textContent = '...';

            const fd = new FormData();
            fd.append('orderItemId', itemId);
            fd.append('__RequestVerificationToken', af);

            try {
                const res  = await fetch('/Order/RemoveItem', { method: 'POST', body: fd });
                const data = await res.json();
                if (!res.ok) {
                    alert(data?.message ?? 'Lỗi xoá');
                    btn.disabled = false; btn.textContent = '✕';
                    return;
                }
                $id('ri-' + itemId)?.remove();
                updateTotal(data.newTotal);
                showToast('Đã xoá món', 'info');
            } catch(e) {
                alert('Lỗi kết nối!');
                btn.disabled = false; btn.textContent = '✕';
            }
        }

        // ── Print ──────────────────────────────────────────────────
        async function doPrint(id) {
            const btn = $id('print-btn');
            btn.disabled = true; btn.textContent = '⏳ Đang in...';
            try {
                const res = await fetch('/Order/Print?id=' + id);
                if (res.ok) {
                    btn.textContent = '✓ Đã in!';
                    btn.style.cssText = 'background:var(--teal-50);color:var(--teal-700);border-color:var(--teal-400);';
                    setTimeout(() => {
                        btn.disabled = false;
                        btn.textContent = '🖨 In hóa đơn';
                        btn.style = '';
                    }, 3000);
                } else {
                    alert('Lỗi in: ' + res.status);
                    btn.disabled = false; btn.textContent = '🖨 In hóa đơn';
                }
            } catch {
                alert('Không kết nối được máy in!');
                btn.disabled = false; btn.textContent = '🖨 In hóa đơn';
            }
        }

        // ── Tap ngoài popup để đóng ────────────────────────────────
        $id('add-popup')?.addEventListener('click', function(e) {
            if (e.target === this) closeAddPopup();
        });

        initSignalR('pos', {});
        renderQR();
    </script>
}
