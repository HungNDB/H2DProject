@using H2DProject.Data
@model Order
@{
    ViewData["Title"] = "Hoá đơn #" + Model.OrderId;
    var banks = ViewBag.Banks as List<BankAccount> ?? new();
    var products = ViewBag.Products as List<Product> ?? new();
    var toppings = ViewBag.Toppings as List<Topping> ?? new();
    var canEdit = Model.Status != "Completed" && Model.Status != "Cancelled";
}

@* ── Popup thêm món ── *@
@if (canEdit && products.Any())
{
    <div id="add-popup" class="add-popup-overlay">
        <div class="add-popup-box">

            <div class="add-popup-hd">
                <div>
                    <div style="font-weight:600;font-size:15px;">Thêm món</div>
                    <div style="font-size:11px;color:#9ca3af;">Đơn #@Model.OrderId · @(Model.Table?.TableNumber ?? "Mang về")</div>
                </div>
                <button class="add-popup-close" onclick="closeAddPopup()">✕</button>
            </div>

            <div class="add-popup-search" id="ap-search-bar">
                <span class="add-search-icon">⌕</span>
                <input type="text" id="ap-search" class="add-search-input"
                       placeholder="Tìm món..." autocomplete="off" oninput="apSearch()">
            </div>

            <div class="add-popup-list" id="ap-list">
                @foreach (var p in products)
                {
                    <div class="ap-row"
                         data-name="@p.Name"
                         onclick="selectProduct(@p.ProductId,'@Html.Raw(p.Name.Replace("'", "\\'"))',@p.Price)">
                        <div class="ap-row-info">
                            <div class="ap-row-name">@p.Name</div>
                            <div class="ap-row-cat">@p.Category?.Name</div>
                        </div>
                        <div class="ap-row-price">@p.Price.ToString("N0") ₫</div>
                        <button class="ap-row-add">+</button>
                    </div>
                }
            </div>

            @if (toppings.Any())
            {
                <div class="add-topping-section" id="ap-topping-section" style="display:none;">
                    <div class="add-topping-hd">
                        <span id="ap-selected-name" style="font-weight:600;font-size:13px;"></span>
                        <span id="ap-selected-price" style="font-size:12px;color:#c9952c;"></span>
                    </div>
                    <div class="add-topping-label">Chọn topping (tuỳ chọn)</div>
                    @foreach (var t in toppings)
                    {
                        <div class="add-topping-row">
                            <label class="add-topping-label-wrap">
                                <input type="checkbox" class="ap-topping-cb"
                                       value="@t.ToppingId"
                                       data-price="@t.Price"
                                       data-name="@t.Name"
                                       onchange="recalcAddTotal()">
                                <span class="add-topping-name">@t.Name</span>
                            </label>
                            <span class="add-topping-price">+@t.Price.ToString("N0") ₫</span>
                        </div>
                    }
                    <div class="add-topping-total">
                        <span>Tổng món:</span>
                        <span id="ap-total-price" style="font-weight:700;color:#c9952c;">0 ₫</span>
                    </div>
                    <div class="add-topping-btns">
                        <button class="btn btn-secondary btn-sm" onclick="backToList()">← Chọn lại</button>
                        <button class="btn btn-primary" style="flex:1;" onclick="confirmAddItem()">
                            Thêm vào đơn +
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="add-topping-section" id="ap-topping-section" style="display:none;">
                    <div class="add-topping-hd">
                        <span id="ap-selected-name" style="font-weight:600;font-size:13px;"></span>
                        <span id="ap-selected-price" style="font-size:12px;color:#c9952c;"></span>
                    </div>
                    <div class="add-topping-btns">
                        <button class="btn btn-secondary btn-sm" onclick="backToList()">← Chọn lại</button>
                        <button class="btn btn-primary" style="flex:1;" onclick="confirmAddItem()">
                            Thêm vào đơn +
                        </button>
                    </div>
                </div>
            }

        </div>
    </div>
}

@* ── Main receipt ── *@
<div style="max-width:400px;margin:0 auto;">

    <div style="display:flex;gap:8px;margin-bottom:16px;justify-content:flex-end;flex-wrap:wrap;">
        <button class="btn btn-secondary btn-sm" id="print-btn" onclick="doPrint(@Model.OrderId)">
            🖨 In hóa đơn
        </button>
        <a asp-controller="LabelPrint" asp-action="Index" asp-route-orderId="@Model.OrderId"
           class="btn btn-secondary btn-sm"
           style="border-color:#c9952c;color:#c9952c;background:#fbf1dc;">
            🏷 In tem
        </a>
        @if (canEdit)
        {
            <button class="btn btn-secondary btn-sm" onclick="openAddPopup()"
                    style="border-color:#c9952c;color:#c9952c;background:#fbf1dc;">
                + Thêm món
            </button>
        }
        <a asp-action="Index" class="btn btn-primary btn-sm">+ Đơn mới</a>
    </div>

    <div class="receipt-card">

        <div class="receipt-header">
            <div style="font-size:28px;margin-bottom:6px;">☕</div>
            <h1>Hyang Cafe</h1>
            <p>Hoá đơn thanh toán</p>
        </div>

        <div class="receipt-meta">
            <div class="receipt-meta-item">
                <div class="label">Số đơn</div><div class="value">#@Model.OrderId</div>
            </div>
            <div class="receipt-meta-item">
                <div class="label">Bàn</div>
                <div class="value">@(Model.Table?.TableNumber ?? "Mang về")</div>
            </div>
            <div class="receipt-meta-item">
                <div class="label">Thời gian</div>
                <div class="value">@Model.CreatedAt?.ToString("HH:mm dd/MM/yyyy")</div>
            </div>
            <div class="receipt-meta-item">
                <div class="label">Thanh toán</div>
                <div class="value">@(Model.PaymentMethod ?? "—")</div>
            </div>
            <div class="receipt-meta-item">
                <div class="label">Nhân viên</div>
                <div class="value">@(Model.Staff?.FullName ?? "—")</div>
            </div>
            <div class="receipt-meta-item">
                <div class="label">Trạng thái</div>
                <div class="value">
                    <span class="badge badge-@Model.Status?.ToLower()">
                        @(Model.Status == "Completed" ? "Hoàn thành" : Model.Status)
                    </span>
                </div>
            </div>
        </div>

        <div class="receipt-items" id="receipt-items">
            @foreach (var item in Model.OrderItems)
            {
                <div class="ri-wrap" id="ri-@item.OrderItemId">
                    <div class="receipt-item">
                        <span>
                            <span class="ri-qty">×@item.Quantity</span>
                            @(item.Product?.Name ?? "—")
                            @if (!string.IsNullOrEmpty(item.Note))
                            {
                                <span style="font-size:11px;color:var(--gray-300);"> (@item.Note)</span>
                            }
                        </span>
                        <div style="display:flex;align-items:center;gap:6px;">
                            <span class="ri-price">@((item.Quantity * item.UnitPrice).ToString("N0")) ₫</span>
                            @if (canEdit)
                            {
                                <button class="ri-del" onclick="removeItem(@item.OrderItemId,this)" title="Xoá">✕</button>
                            }
                        </div>
                    </div>
                    @foreach (var t in item.OrderItemToppings)
                    {
                        <div class="receipt-item" style="padding-left:20px;font-size:.88em;color:var(--gray-400);">
                            <span><span style="color:#c9952c;">+@t.Quantity</span> @(t.Topping?.Name ?? "—")</span>
                            <span class="ri-price" style="color:var(--gray-400);">
                                @((t.Quantity * t.UnitPrice).ToString("N0")) ₫
                            </span>
                        </div>
                    }
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.Note))
        {
            <div style="margin:0 20px 10px;font-size:12px;color:var(--gray-400);font-style:italic;">
                Ghi chú: @Model.Note
            </div>
        }

        <div class="receipt-totals">
            <div class="receipt-row">
                <span class="label">Tạm tính</span>
                <span class="value" id="disp-subtotal">@Model.SubTotal?.ToString("N0") ₫</span>
            </div>
            @if ((Model.Vatamount ?? 0) > 0)
            {
                <div class="receipt-row">
                    <span class="label">VAT</span>
                    <span class="value">@Model.Vatamount?.ToString("N0") ₫</span>
                </div>
            }
            @if ((Model.Discount ?? 0) > 0)
            {
                <div class="receipt-row" style="color:var(--red-600);">
                    <span class="label">🎁 Ưu đãi</span>
                    <span class="value">−@Model.Discount?.ToString("N0") ₫</span>
                </div>
            }
            <div class="receipt-total-row">
                <span>TỔNG CỘNG</span>
                <span class="value" id="disp-total">@Model.TotalAmount?.ToString("N0") ₫</span>
            </div>
        </div>

        <div class="receipt-qr">
            <div class="receipt-qr-label">Quét để chuyển khoản</div>

            @if (banks.Any())
            {
                <div class="rc-bank-tabs" id="bank-tabs">
                    @for (int i = 0; i < banks.Count; i++)
                    {
                        <button class="rc-bank-tab @(i == 0 ? "active" : "")"
                                data-idx="@i" onclick="selectBank(this)">
                            @banks[i].BankName
                        </button>
                    }
                </div>
            }

            <div id="qr-code-canvas">
                <img id="vietqr-img" src="" width="140" height="140"
                     style="border-radius:4px;display:block;" alt="QR chuyển khoản" />
            </div>
            <div class="receipt-qr-sub" id="qr-sub">
                Hyang Cafe · Đơn #@Model.OrderId · <span id="qr-amount-text">@Model.TotalAmount?.ToString("N0") ₫</span>
            </div>
        </div>

        <div class="receipt-footer">
            Cảm ơn quý khách! Hẹn gặp lại ☕<br>
            <span style="font-size:10px;">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

