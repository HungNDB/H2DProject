@section Scripts {
    <script>
        const af = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

        // ── Nhóm quick tags ─────────────────────────────────────
        function switchGroup(btn) {
            document.querySelectorAll('.fo-gtab').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const groups = ['drinks','fruits','dairy','supply','util'];
            groups.forEach(g => {
                document.getElementById('fo-tags-' + g).style.display =
                    g === btn.dataset.group ? 'flex' : 'none';
            });
        }

        // ── Quick tag helpers ───────────────────────────────────
        function setField(id, val) {
            document.getElementById(id).value = val;
        }

        // ── Popup nhập liệu ────────────────────────────────────
        function openPopup() {
            document.getElementById('fo-popup').style.display = 'flex';
            setTimeout(() => document.getElementById('f-foodname').focus(), 150);
        }
        function closePopup() {
            document.getElementById('fo-popup').style.display = 'none';
            ['f-foodname','f-qty','f-supplier','f-origin','f-invoice','f-condition','f-receivedby','f-note']
                .forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
            document.getElementById('f-unit').value = '';
            document.getElementById('f-date').value = new Date().toISOString().split('T')[0];
        }
        document.getElementById('fo-popup').addEventListener('click', function(e) {
            if (e.target === this) closePopup();
        });

        // ── Submit nhập liệu ───────────────────────────────────
        async function submitLog() {
            const foodName = document.getElementById('f-foodname').value.trim();
            if (!foodName) {
                alert('Vui lòng nhập tên thực phẩm!');
                document.getElementById('f-foodname').focus();
                return;
            }

            const btn = document.getElementById('fo-submit-btn');
            btn.disabled = true; btn.textContent = 'Đang lưu...';

            const fd = new FormData();
            fd.append('entryDate',   document.getElementById('f-date').value);
            fd.append('foodName',    foodName);
            fd.append('quantity',    document.getElementById('f-qty').value);
            fd.append('unit',        document.getElementById('f-unit').value);
            fd.append('supplier',    document.getElementById('f-supplier').value.trim());
            fd.append('origin',      document.getElementById('f-origin').value.trim());
            fd.append('invoiceInfo', document.getElementById('f-invoice').value.trim());
            fd.append('condition',   document.getElementById('f-condition').value.trim());
            fd.append('receivedBy',  document.getElementById('f-receivedby').value.trim());
            fd.append('note',        document.getElementById('f-note').value.trim());
            fd.append('__RequestVerificationToken', af);

            try {
                const res  = await fetch('/FoodOrigin/Create', { method: 'POST', body: fd });
                const data = await res.json();
                if (!res.ok) { alert('Lỗi: ' + (data.message || res.status)); return; }

                // Thêm row mới vào list
                const list = document.getElementById('fo-list');
                const empty = list.querySelector('div[style*="text-align:center"]');
                if (empty) empty.remove();

                const qty      = document.getElementById('f-qty').value;
                const unit     = document.getElementById('f-unit').value;
                const supplier = document.getElementById('f-supplier').value.trim();
                const origin   = document.getElementById('f-origin').value.trim();
                const cond     = document.getElementById('f-condition').value.trim();
                const inv      = document.getElementById('f-invoice').value.trim();
                const recv     = document.getElementById('f-receivedby').value.trim();

                const qtyText  = qty  ? `· ${qty} ${unit}` : '';
                const suppText = supplier ? `· ${supplier}` : '';
                const origText = origin   ? `· ${origin}`   : '';
                const condTag  = cond ? `<span class="fo-tag fo-tag-green">${cond}</span>` : '';
                const invTag   = inv  ? `<span class="fo-tag fo-tag-blue">HĐ: ${inv}</span>` : '';
                const tagsHtml = (condTag || invTag)
                    ? `<div class="fo-row-tags">${condTag}${invTag}</div>` : '';
                const recvHtml = recv
                    ? `<div class="fo-row-receiver">👤 ${recv}</div>` : '';

                const row = document.createElement('div');
                row.className = 'fo-row';
                row.id = 'fo-' + data.logId;
                row.innerHTML = `
                    <div class="fo-row-icon">🥦</div>
                    <div class="fo-row-body">
                        <div class="fo-row-name">${data.foodName}</div>
                        <div class="fo-row-meta">${data.entryDate} ${qtyText} ${suppText} ${origText}</div>
                        ${tagsHtml}
                    </div>
                    <div class="fo-row-right">
                        ${recvHtml}
                        <button class="exp-del-btn" onclick="deleteLog(${data.logId}, this)">✕</button>
                    </div>`;

                list.insertAdjacentElement('afterbegin', row);

                // Cập nhật đếm
                const countEl = document.getElementById('total-count');
                countEl.textContent = parseInt(countEl.textContent || '0') + 1;

                closePopup();
                showToast?.('✓ Đã ghi: ' + data.foodName, 'success');
            } catch(e) {
                alert('Lỗi kết nối!');
            } finally {
                btn.disabled = false; btn.textContent = '💾 Lưu vào sổ';
            }
        }

        // ── Xoá ───────────────────────────────────────────────
        async function deleteLog(id, btn) {
            if (!confirm('Xoá dòng này khỏi sổ?')) return;
            btn.disabled = true;
            const fd = new FormData();
            fd.append('id', id);
            fd.append('__RequestVerificationToken', af);
            try {
                const res = await fetch('/FoodOrigin/Delete', { method: 'POST', body: fd });
                if (res.ok) {
                    document.getElementById('fo-' + id)?.remove();
                    const countEl = document.getElementById('total-count');
                    countEl.textContent = Math.max(0, parseInt(countEl.textContent || '0') - 1);
                    showToast?.('Đã xoá', 'info');
                } else {
                    alert('Lỗi xoá!'); btn.disabled = false;
                }
            } catch { alert('Lỗi kết nối!'); btn.disabled = false; }
        }

        // ── Xuất Excel ─────────────────────────────────────────
        function openExportPopup() {
            document.getElementById('export-popup').style.display = 'flex';
        }
        function closeExportPopup() {
            document.getElementById('export-popup').style.display = 'none';
        }
        document.getElementById('export-popup').addEventListener('click', function(e) {
            if (e.target === this) closeExportPopup();
        });

        function doExport() {
            const from  = document.querySelector('input[name="from"]')?.value || '@ViewBag.From';
            const to    = document.querySelector('input[name="to"]')?.value   || '@ViewBag.To';
            const q     = document.querySelector('input[name="q"]')?.value    || '';
            const name  = document.getElementById('ex-shopname').value.trim();
            const addr  = document.getElementById('ex-address').value.trim();
            const phone = document.getElementById('ex-phone').value.trim();

            const url = `/FoodOrigin/ExportExcel?from=${from}&to=${to}` +
                        `&q=${encodeURIComponent(q)}` +
                        `&shopName=${encodeURIComponent(name)}` +
                        `&shopAddress=${encodeURIComponent(addr)}` +
                        `&shopPhone=${encodeURIComponent(phone)}`;

            closeExportPopup();
            window.location.href = url;
        }
    </script>
}
