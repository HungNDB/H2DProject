            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 12px 14px;
            border-bottom: 1px solid #f9fafb;
        }

            .fo-row:last-child {
                border-bottom: none;
            }

        .fo-row-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: #fbf1dc;
            display: flex;
            align-items: center;
