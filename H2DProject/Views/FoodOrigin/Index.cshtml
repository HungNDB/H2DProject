            font-size: 13px;
            font-weight: 600;
            color: #111827;
        }

        .fo-row-meta {
            font-size: 11px;
            color: #9ca3af;
            margin-top: 2px;
        }

        .fo-row-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            margin-top: 5px;
        }

        .fo-tag {
            padding: 2px 8px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 600;
        }

        .fo-tag-green {
            background: #dcfce7;
