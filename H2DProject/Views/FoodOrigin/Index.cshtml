        }

        .fo-input {
            width: 100%;
            padding: 9px 12px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            font-size: 14px;
            background: #fff;
            color: #111827;
            box-sizing: border-box;
        }

            .fo-input:focus {
                outline: none;
                border-color: #c9952c;
                box-shadow: 0 0 0 3px rgba(201,149,44,.1);
            }

        .fo-group-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            margin-bottom: 7px;
        }

        .fo-gtab {
            padding: 4px 11px;
            border: 1.5px solid #e5e7eb;
            border-radius: 999px;
            background: #f9fafb;
            font-size: 11px;
            font-weight: 600;
            color: #6b7280;
            cursor: pointer;
            white-space: nowrap;
            transition: all .12s;
        }

            .fo-gtab.active {
                border-color: #c9952c;
                background: #fbf1dc;
                color: #c9952c;
            }

        .fo-quick-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            margin-bottom: 6px;
        }

        .fo-qtag {
            padding: 3px 10px;
            border: 1px solid #e5e7eb;
            border-radius: 999px;
            font-size: 11px;
            cursor: pointer;
            background: #f9fafb;
            color: #374151;
        }

